# Copy to .env and fill in values locally. Names only — never commit real values.
# Every variable is optional: without them the stack runs in labelled DEMO mode.

# ── Backend-only (FastAPI). Never expose these to Vite or Expo bundles. ──────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret required for privileged operator actions (alert approval, agent runs
# that draft notifications). If unset, privileged actions are allowed only from loopback.
BHUDRISHTI_OPERATOR_TOKEN=
# Optional device ingest key. If set, POST /api/ingest requires header X-Device-Key.
BHUDRISHTI_DEVICE_KEY=
# Per-client ingest rate limit (requests per minute).
BHUDRISHTI_INGEST_RATE_PER_MIN=120
# Comma-separated CORS origins (default: *)
BHUDRISHTI_CORS_ORIGINS=

# Sarvam (translation/TTS/STT) — server-side only.
SARVAM_API_KEY=

# Optional AI providers for the agent subsystem (none are required).
XAI_API_KEY=
XAI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
HF_API_TOKEN=
HF_MODEL=
OLLAMA_BASE_URL=
OLLAMA_MODEL=
# Comma-separated provider order, e.g. ollama,groq,openrouter,gemini,huggingface,grok,rules
AGENT_PROVIDER_ORDER=
AGENT_TIMEOUT_SECONDS=12

# ── Frontend (Vite). Only public values: the anon key is designed to be public and
# is constrained by RLS. Never put the service-role key here. ─────────────────
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Mobile (Expo). Public values only. ─────────────────────────────────────────
EXPO_PUBLIC_API_URL=
