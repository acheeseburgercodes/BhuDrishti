{
  "expo": {
    "name": "BhuDrishti",
    "slug": "bhudrishti-mobile",
    "version": "2.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": { "backgroundColor": "#0d1413" },
    "android": {
      "package": "com.bhudrishti.mobile",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.bhudrishti.mobile"
    },
    "plugins": [
      ["expo-sensors", { "motionPermission": "BhuDrishti records short motion samples you start yourself to detect ground vibration near the river." }]
    ]
  }
}
